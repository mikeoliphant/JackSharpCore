<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>JackSharpTest.NAudio</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="4.0.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.10.0" />
    <ProjectReference Include="../JackSharp/JackSharp.csproj" />
    <ProjectReference Include="../Jack.NAudio/Jack.NAudio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same JACK server for these tests: one already running, or a dummy-backend jackd started for them. -->
    <Compile Include="../JackSharpTest/TestServer.cs" Link="TestServer.cs" />
  </ItemGroup>
</Project>
